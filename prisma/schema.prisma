generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BUYER
  SELLER
}

enum Availability {
  AVAILABLE
  ASK_SELLER
  UNAVAILABLE
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum RequestStatus {
  NEW
  MATCHED
  CONTACTED
  FULFILLED
  UNFULFILLED
  CLOSED
}

enum SocialPlatform {
  WHATSAPP
  INSTAGRAM
  TIKTOK
  FACEBOOK
  PHONE
  DIRECTIONS
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum LocationVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClaimRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
}

enum ReferralRewardType {
  PRODUCT_SLOTS
  BUYER_MILESTONE
}

enum ReferralRewardStatus {
  GRANTED
  REVOKED
}

/**
 * Notification priority.
 */
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/**
 * Notification delivery channels.
 */
enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
  SMS
}

/**
 * Delivery status for a notification channel.
 */
enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

/**
 * ReMarket notification event types.
 */
enum NotificationType {
  REQUEST_CREATED
  REQUEST_MATCHED
  REQUEST_RESPONDED
  REQUEST_UPDATED
  REQUEST_FULFILLED
  REQUEST_CLOSED
  REQUEST_UNFULFILLED

  BUSINESS_APPROVED
  BUSINESS_REJECTED
  BUSINESS_UPDATED
  BUSINESS_VERIFIED
  BUSINESS_DEACTIVATED
  BUSINESS_DELETION_REQUESTED
  BUSINESS_DELETION_APPROVED
  BUSINESS_DELETION_REJECTED
  BUSINESS_REPORTED

  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED

  PRODUCT_ADDED
  PRODUCT_UPDATED
  PRODUCT_REMOVED
  PRODUCT_AVAILABILITY_CHANGED

  REVIEW_RECEIVED
  REVIEW_REPLIED
  REVIEW_REPORTED
  REVIEW_REMOVED

  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PREMIUM_ACTIVATED
  PREMIUM_EXPIRING
  PREMIUM_EXPIRED

  SECURITY_ALERT

  SYSTEM_ANNOUNCEMENT
}

/**
 * Audience for admin-created announcements.
 */
enum NotificationAudience {
  EVERYONE
  BUYERS
  SELLERS
  ADMINS
  SELECTED_USERS
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  name      String?
  createdAt DateTime @default(now())

  /**
   * REFERRALS
   * Nullable so existing users do not require
   * a referral code during the schema migration.
   * The referral service should generate a code
   * when an eligible account first needs one.
   */
  referralCode String? @unique

  // Referrals made by this user.
  referralsMade Referral[] @relation("ReferralReferrer")

  // Referral through which this user joined.
  // Unique referredUserId allows at most one referral.
  referralReceived Referral? @relation("ReferralReferredUser")

  // Rewards granted to this user.
  referralRewards ReferralReward[] @relation("ReferralRewardOwner")

  // Seller-owned business.
  // ownerId on Business is unique, so V1 supports one business per seller.
  business Business?

  // Products soft-deleted by this user.
  deletedProducts Product[] @relation("ProductDeletedBy")

  // Business deletion requests created by this user.
  deletionRequestsRequested BusinessDeletionRequest[] @relation("BusinessDeletionRequestedBy")

  // Business deletion requests reviewed by this user.
  deletionRequestsReviewed BusinessDeletionRequest[] @relation("BusinessDeletionReviewedBy")

  // Business claim requests created by this user.
  claimRequestsRequested BusinessClaimRequest[] @relation("BusinessClaimRequestedBy")

  // Business claim requests reviewed by this user.
  claimRequestsReviewed BusinessClaimRequest[] @relation("BusinessClaimReviewedBy")

  // Reviews written by this buyer.
  reviews BusinessReview[]

  // Notifications belonging to this user.
  notifications Notification[]

  // Per-notification-type delivery preferences.
  notificationPreferences NotificationPreference[]

  // Admin-created notification announcements.
  notificationAnnouncements NotificationAnnouncement[] @relation("NotificationAnnouncementCreatedBy")

  // Business views attributed to this authenticated user.
  // Anonymous business-view tracking remains supported.
  businessViewEvents BusinessViewEvent[]
}

/**
 * REFERRAL ATTRIBUTION
 * Each record represents one account referred
 * by another ReMarket account.
 * The application service must validate:
 * - The referrer exists and is eligible.
 * - The referrer is not an ADMIN.
 * - The referrer is not the referred user.
 * - Attribution cannot be changed after creation.
 * - The correct qualification rules have been met.
 */
model Referral {
  id String @id @default(cuid())

  // User who referred the new account.
  referrerId String

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)

  // The referred account can have only one referrer.
  referredUserId String @unique

  referredUser User @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  // Role snapshots retained for reporting and audit.
  referrerRole Role
  referredRole Role

  status ReferralStatus @default(PENDING)

  qualifiedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  rewards ReferralReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([status, createdAt])
  @@index([referredRole, status])
}

/**
 * REFERRAL REWARD LEDGER
 * Rewards must be created by trusted server-side
 * code after qualification.
 * PRODUCT_SLOTS represents additional seller product
 * capacity and must be included by the existing
 * product-capacity calculation.
 * BUYER_MILESTONE represents a non-cash buyer benefit.
 * rewardKey is an application-generated idempotency key.
 * Use a deterministic value for each intended reward so
 * retries cannot grant the same benefit twice.
 * Example keys:
 * referral:<referralId>:PRODUCT_SLOTS
 * user:<userId>:BUYER_MILESTONE:<milestoneNumber>
 */
model ReferralReward {
  id String @id @default(cuid())

  // User receiving the reward.
  userId String

  user User @relation("ReferralRewardOwner", fields: [userId], references: [id], onDelete: Restrict)

  // Referral responsible for the reward, if applicable.
  referralId String?

  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  type ReferralRewardType

  status ReferralRewardStatus @default(GRANTED)

  // For example, 3 additional product slots.
  quantity Int @default(1)

  // Buyer referral milestone, such as milestone 3.
  // Nullable for reward types that do not use milestones.
  milestone Int?

  // Prevents duplicate grants when the service retries.
  rewardKey String @unique

  grantedAt DateTime @default(now())
  createdAt DateTime @default(now())

  // One reward of a given type per referral.
  // PostgreSQL allows multiple NULL referralId values.
  @@unique([referralId, type])
  // Prevents the same non-null buyer milestone
  // from being granted more than once to a user.
  @@unique([userId, type, milestone])
  @@index([userId, status])
  @@index([type, status])
  @@index([referralId])
}

/**
 * ============================================================
 * LOCATIONS
 * ============================================================
 */

model Location {
  id String @id @default(cuid())

  // Human-readable area.
  // NOT unique because many businesses can exist in the same area.
  area String

  // Canonical street/road name used by the
  // ReMarket Near Me street-ranking system.
  street String?

  // Human-readable business location/address.
  address String?

  // Stored internally for exact location / Near Me / Directions.
  lat  Float?
  long Float?

  // Location verification is separate from Business verification.
  verification LocationVerificationStatus @default(UNVERIFIED)

  businesses Business[]

  @@index([area])
  @@index([street])
  @@index([lat, long])
  @@index([verification])
}

model BusinessSocialLink {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  handle   String

  @@index([businessId])
  @@index([businessId, platform])
}

model Category {
  id String @id @default(cuid())

  name String @unique

  // Lucide icon key, e.g. "Shirt", "Utensils", "Briefcase".
  iconKey String @default("Store")

  // Admin controls whether this category is available
  // throughout ReMarket.
  isActive Boolean @default(true)

  // Controls display order on buyer/admin category lists.
  sortOrder Int @default(0)

  business BusinessCategory[]
  products Product[]
  requests BuyerRequest[]

  @@index([isActive, sortOrder])
}

model BusinessCategory {
  businessId String
  categoryId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
}

/**
 * ============================================================
 * BUSINESSES
 * ============================================================
 */

model Business {
  id String @id @default(cuid())

  name String

  ownerName String?

  // Seller account that owns this business.
  // Optional because existing manually onboarded businesses
  // may not yet belong to a seller account.
  ownerId String? @unique

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  description String?

  locationId String?

  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  priceMin Int?
  priceMax Int?

  availability Availability @default(ASK_SELLER)

  phone String?

  status       BusinessStatus     @default(ACTIVE)
  verification VerificationStatus @default(UNVERIFIED)

  notes    String?
  imageUrl String?

  onboardedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // Soft delete.
  // null = active
  // timestamp = soft-deleted
  deletedAt DateTime?

  categories       BusinessCategory[]
  products         Product[]
  socialLinks      BusinessSocialLink[]
  matches          Match[]
  contactEvents    ContactEvent[]
  deletionRequests BusinessDeletionRequest[]
  claimRequests    BusinessClaimRequest[]
  viewEvents       BusinessViewEvent[]
  reviews          BusinessReview[]

  @@index([status])
  @@index([verification])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([ownerId])
  @@index([locationId])
}

model BusinessReview {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Whole-number rating from 1 to 5.
  // API validation will enforce the allowed range.
  rating Int

  // Optional written review.
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One buyer can have only one review for a business.
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

/**
 * ============================================================
 * PRODUCTS
 * ============================================================
 */

model Product {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id])

  price    Int?
  priceMin Int?
  priceMax Int?

  availability Availability @default(ASK_SELLER)

  keywords String[] @default([])

  imageUrl String?

  images ProductImage[]

  // Existing product status preserved.
  status BusinessStatus @default(ACTIVE)

  // Soft delete.
  deletedAt DateTime?

  // Audit: which authenticated user deleted this product?
  deletedById String?

  deletedBy User? @relation("ProductDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, deletedAt])
  @@index([categoryId])
  @@index([deletedAt])
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  publicId String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, sortOrder])
}

/**
 * ============================================================
 * BUYER REQUESTS AND MATCHES
 * ============================================================
 */

model BuyerRequest {
  id String @id @default(cuid())

  query       String
  requestCode String @unique

  categoryId String?

  // A category can be deactivated/deleted without destroying
  // historical buyer requests.
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  budget       Int?
  locationArea String?
  quantity     Int?
  description  String?
  imageUrl     String?

  status RequestStatus @default(NEW)

  buyerContact String?

  createdAt DateTime @default(now())

  matches Match[]

  @@index([status])
  @@index([buyerContact])
  @@index([categoryId])
}

model Match {
  id String @id @default(cuid())

  requestId String

  request BuyerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  score         Int     @default(0)
  addedManually Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([requestId, businessId])
  @@index([businessId])
}

/**
 * ============================================================
 * ANALYTICS EVENTS
 * ============================================================
 */

model ContactEvent {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id])

  // Existing request reference preserved as a scalar.
  requestId String?

  platform SocialPlatform

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, platform])
  @@index([createdAt])
}

model SearchEvent {
  id String @id @default(cuid())

  query       String
  category    String?
  resultCount Int     @default(0)
  location    String?
  minPrice    Int?
  maxPrice    Int?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

model BusinessViewEvent {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id])

  // Anonymous stable visitor identifier generated by the application.
  // This is not the user's email or phone number.
  visitorId String

  /**
   * Optional authenticated user association.
   * Existing anonymous events remain valid because userId is nullable.
   * The server must populate this field from the authenticated session,
   * never from a userId submitted by the browser.
   */
  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, visitorId])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, businessId, createdAt])
}

model AdminNote {
  id String @id @default(cuid())

  businessId String?
  requestId  String?

  content   String
  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([requestId])
}

/**
 * ============================================================
 * BUSINESS DELETION REQUESTS
 * ============================================================
 */

model BusinessDeletionRequest {
  id String @id @default(cuid())

  businessId String

  // Preserve deletion-request history rather than cascading it away
  // during an accidental hard-delete of a business.
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  // Seller/admin account that submitted the request.
  requestedById String

  requestedBy User @relation("BusinessDeletionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  reason String?

  status DeletionRequestStatus @default(PENDING)

  // Admin who reviewed the request.
  reviewedById String?

  reviewedBy User? @relation("BusinessDeletionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}

/**
 * ============================================================
 * BUSINESS CLAIM REQUESTS
 * ============================================================
 */

model BusinessClaimRequest {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  // Seller account requesting ownership.
  requestedById String

  requestedBy User @relation("BusinessClaimRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  reason String?

  status ClaimRequestStatus @default(PENDING)

  // Admin who reviewed the claim.
  reviewedById String?

  reviewedBy User? @relation("BusinessClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, requestedById, status])
  @@index([businessId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}

/**
 * ============================================================
 * REMARKET NOTIFICATION SYSTEM
 * ============================================================
 */

/**
 * Stores one notification for one recipient.
 * Each user has independent read/unread state.
 */
model Notification {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  message  String
  priority NotificationPriority @default(NORMAL)

  /**
   * Structured contextual information.
   */
  data Json?

  /**
   * Null = unread.
   * Set = read.
   */
  readAt DateTime?

  /**
   * Prevents accidental duplicate notifications.
   */
  dedupeKey String? @unique

  /**
   * Optional reference to an admin-created announcement.
   */
  announcementId String?

  announcement NotificationAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, type])
  @@index([type])
  @@index([announcementId])
}

/**
 * Tracks delivery of a notification through a specific channel.
 */
model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel

  status NotificationDeliveryStatus @default(PENDING)

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  /**
   * Provider-specific message/reference ID.
   */
  providerMessageId String?

  /**
   * Provider error information.
   */
  error String?

  createdAt DateTime @default(now())

  /**
   * One notification can only have one delivery
   * record for each channel.
   */
  @@unique([notificationId, channel])
  @@index([notificationId])
  @@index([channel, status])
  @@index([status])
}

/**
 * Per-user notification preferences.
 * A missing preference row means the application
 * default applies.
 */
model NotificationPreference {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationType NotificationType

  inApp    Boolean @default(true)
  push     Boolean @default(false)
  email    Boolean @default(false)
  whatsapp Boolean @default(false)
  sms      Boolean @default(false)

  updatedAt DateTime @updatedAt

  /**
   * One preference record per user and notification type.
   */
  @@unique([userId, notificationType])
  @@index([userId])
  @@index([notificationType])
}

/**
 * Admin-created announcement.
 * The announcement defines the audience.
 * Individual Notification rows are then created
 * for the users who should receive it.
 */
model NotificationAnnouncement {
  id String @id @default(cuid())

  title   String
  message String

  audience NotificationAudience

  priority NotificationPriority @default(NORMAL)

  createdById String

  createdBy User @relation("NotificationAnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /**
   * Optional structured metadata.
   */
  data Json?

  notifications Notification[]

  createdAt DateTime @default(now())

  @@index([audience])
  @@index([createdById])
  @@index([createdAt])
}
