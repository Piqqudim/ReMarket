generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BUYER
  SELLER
}

enum Availability {
  AVAILABLE
  ASK_SELLER
  UNAVAILABLE
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum RequestStatus {
  NEW
  MATCHED
  CONTACTED
  FULFILLED
  UNFULFILLED
  CLOSED
}

enum SocialPlatform {
  WHATSAPP
  INSTAGRAM
  TIKTOK
  FACEBOOK
  PHONE
  DIRECTIONS
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum LocationVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClaimRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  name      String?
  createdAt DateTime @default(now())

  // Seller-owned business.
  // ownerId on Business is unique, so V1 supports one business per seller.
  business Business?

  // Products soft-deleted by this user.
  deletedProducts Product[] @relation("ProductDeletedBy")

  // Business deletion requests created by this user.
  deletionRequestsRequested BusinessDeletionRequest[] @relation("BusinessDeletionRequestedBy")

  // Business deletion requests reviewed by this user.
  deletionRequestsReviewed BusinessDeletionRequest[] @relation("BusinessDeletionReviewedBy")

  // Business claim requests created by this user.
  claimRequestsRequested BusinessClaimRequest[] @relation("BusinessClaimRequestedBy")

  // Business claim requests reviewed by this user.
  claimRequestsReviewed BusinessClaimRequest[] @relation("BusinessClaimReviewedBy")

  // Reviews written by this buyer.
  reviews BusinessReview[]
}

model Location {
  id String @id @default(cuid())

  // Human-readable area.
  // NOT unique because many businesses can exist in the same area.
  area String

  // Canonical street/road name used by the
  // ReMarket Near Me street-ranking system.
  //
  // Nullable for backwards compatibility with
  // existing locations created before street
  // storage was introduced.
  street String?

  // Human-readable business location/address.
  address String?

  // Stored internally for exact location / Near Me / Directions.
  lat  Float?
  long Float?

  // Location verification is separate from Business verification.
  verification LocationVerificationStatus @default(UNVERIFIED)

  businesses Business[]

  @@index([area])
  @@index([street])
  @@index([lat, long])
  @@index([verification])
}

model BusinessSocialLink {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  handle   String

  @@index([businessId])
  @@index([businessId, platform])
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  // Lucide icon key, e.g. "Shirt", "Utensils", "Briefcase".
  iconKey String @default("Store")

  // Admin controls whether this category is available
  // throughout ReMarket.
  isActive Boolean @default(true)

  // Controls display order on buyer/admin category lists.
  sortOrder Int @default(0)

  business BusinessCategory[]
  products Product[]
  requests BuyerRequest[]

  @@index([isActive, sortOrder])
}

model BusinessCategory {
  businessId String
  categoryId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
}

model Business {
  id   String @id @default(cuid())
  name String

  ownerName String?

  // Seller account that owns this business.
  // Optional because existing manually onboarded businesses
  // may not yet belong to a seller account.
  ownerId String? @unique
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  description String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  priceMin Int?
  priceMax Int?

  availability Availability @default(ASK_SELLER)

  phone String?

  status       BusinessStatus     @default(ACTIVE)
  verification VerificationStatus @default(UNVERIFIED)

  notes    String?
  imageUrl String?

  onboardedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // Soft delete.
  // null = active
  // timestamp = soft-deleted
  deletedAt DateTime?

  categories       BusinessCategory[]
  products         Product[]
  socialLinks      BusinessSocialLink[]
  matches          Match[]
  contactEvents    ContactEvent[]
  deletionRequests BusinessDeletionRequest[]
  claimRequests    BusinessClaimRequest[]
  viewEvents       BusinessViewEvent[]

  // Ratings and reviews submitted by buyers.
  reviews BusinessReview[]

  @@index([status])
  @@index([verification])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([ownerId])
  @@index([locationId])
}

model BusinessReview {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Whole-number rating from 1 to 5.
  // API validation will enforce the allowed range.
  rating Int

  // Optional written review.
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One buyer can have only one review
  // for a particular business.
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

model Product {
  id         String @id @default(cuid())
  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  price    Int?
  priceMin Int?
  priceMax Int?

  availability Availability @default(ASK_SELLER)

  keywords String[] @default([])

  imageUrl String?
  images   ProductImage[]

  // Existing product status preserved.
  status BusinessStatus @default(ACTIVE)

  // Soft delete.
  deletedAt DateTime?

  // Audit: which authenticated user deleted this product?
  deletedById String?
  deletedBy   User?   @relation("ProductDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, deletedAt])
  @@index([categoryId])
  @@index([deletedAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  publicId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, sortOrder])
}

model BuyerRequest {
  id String @id @default(cuid())

  query       String
  requestCode String @unique

  categoryId String?
  // A category can be deactivated/deleted without destroying
  // historical buyer requests.
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  budget       Int?
  locationArea String?
  quantity     Int?
  description  String?
  imageUrl     String?

  status RequestStatus @default(NEW)

  buyerContact String?

  createdAt DateTime @default(now())

  matches Match[]

  @@index([status])
  @@index([buyerContact])
  @@index([categoryId])
}

model Match {
  id String @id @default(cuid())

  requestId String
  request   BuyerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  score         Int      @default(0)
  addedManually Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([requestId, businessId])
  @@index([businessId])
}

model ContactEvent {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  // Existing request reference preserved as a scalar.
  requestId String?

  platform SocialPlatform

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, platform])
  @@index([createdAt])
}

model SearchEvent {
  id String @id @default(cuid())

  query       String
  category    String?
  resultCount Int     @default(0)
  location    String?
  minPrice    Int?
  maxPrice    Int?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

model BusinessViewEvent {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  // Anonymous stable visitor identifier generated by the application.
  // This is not the user's email or phone number.
  visitorId String

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, visitorId])
  @@index([visitorId, createdAt])
}

model AdminNote {
  id String @id @default(cuid())

  businessId String?
  requestId  String?
  content    String

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([requestId])
}

model BusinessDeletionRequest {
  id String @id @default(cuid())

  businessId String

  // Preserve deletion-request history rather than cascading it away
  // during an accidental hard-delete of a business.
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  // Seller/admin account that submitted the request.
  requestedById String
  requestedBy   User   @relation("BusinessDeletionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  reason String?

  status DeletionRequestStatus @default(PENDING)

  // Admin who reviewed the request.
  reviewedById String?
  reviewedBy   User?   @relation("BusinessDeletionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}

model BusinessClaimRequest {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  // Seller account requesting ownership.
  requestedById String
  requestedBy   User   @relation("BusinessClaimRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  reason String?

  status ClaimRequestStatus @default(PENDING)

  // Admin who reviewed the claim.
  reviewedById String?
  reviewedBy   User?   @relation("BusinessClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, requestedById, status])
  @@index([businessId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}
