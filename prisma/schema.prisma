generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  BUYER
  SELLER
}

enum Availability {
  AVAILABLE
  ASK_SELLER
  UNAVAILABLE
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum RequestStatus {
  NEW
  MATCHED
  CONTACTED
  FULFILLED
  UNFULFILLED
  CLOSED
}

enum SocialPlatform {
  WHATSAPP
  INSTAGRAM
  TIKTOK
  FACEBOOK
  PHONE
  DIRECTIONS
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum LocationVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClaimRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
}

enum ReferralRewardType {
  PRODUCT_SLOTS
  BUYER_MILESTONE
}

enum ReferralRewardStatus {
  GRANTED
  REVOKED
}

/**
 * ============================================================
 * CHECKOUT AND ORDERS ENUMS
 * ============================================================
 */

enum OrderStatus {
  PLACED
  PARTIALLY_ACCEPTED
  CONFIRMED
  PROCESSING
  PARTIALLY_DISPATCHED
  DISPATCHED
  COMPLETED
  PARTIALLY_CANCELLED
  CANCELLED
}

enum SellerOrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  OTHER
}

/**
 * ============================================================
 * SERVICES ENUMS
 * ============================================================
 */

enum ServiceFulfillmentType {
  AT_PROVIDER
  AT_CUSTOMER
  REMOTE
  FLEXIBLE
}

/**
 * REQUEST:
 * Buyer submits what they need and the merchant responds.
 * APPOINTMENT:
 * Buyer requests a preferred date/time and the merchant
 * confirms the appointment.
 */
enum ServiceBookingType {
  REQUEST
  APPOINTMENT
}

/**
 * Booking lifecycle.
 */
enum ServiceBookingStatus {
  PENDING
  AWAITING_BUYER
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
}

/**
 * Notification priority.
 */
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/**
 * Notification delivery channels.
 */
enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
  SMS
}

/**
 * Delivery status for a notification channel.
 */
enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

/**
 * ============================================================
 * REMARKET NOTIFICATION TYPES
 * ============================================================
 */

enum NotificationType {
  REQUEST_CREATED
  REQUEST_MATCHED
  REQUEST_RESPONDED
  REQUEST_UPDATED
  REQUEST_FULFILLED
  REQUEST_CLOSED
  REQUEST_UNFULFILLED

  BUSINESS_APPROVED
  BUSINESS_REJECTED
  BUSINESS_UPDATED
  BUSINESS_VERIFIED
  BUSINESS_DEACTIVATED
  BUSINESS_DELETION_REQUESTED
  BUSINESS_DELETION_APPROVED
  BUSINESS_DELETION_REJECTED

  BUSINESS_REPORTED

  CLAIM_SUBMITTED
  CLAIM_APPROVED
  CLAIM_REJECTED

  PRODUCT_ADDED
  PRODUCT_UPDATED
  PRODUCT_REMOVED
  PRODUCT_AVAILABILITY_CHANGED

  SERVICE_ADDED
  SERVICE_UPDATED
  SERVICE_REMOVED
  SERVICE_AVAILABILITY_CHANGED

  SERVICE_BOOKING_CREATED
  SERVICE_BOOKING_UPDATED
  SERVICE_BOOKING_MESSAGE

  // Product order notifications.
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_STATUS_UPDATED
  ORDER_CANCELLED

  REVIEW_RECEIVED
  REVIEW_REPLIED
  REVIEW_REPORTED
  REVIEW_REMOVED

  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PREMIUM_ACTIVATED
  PREMIUM_EXPIRING
  PREMIUM_EXPIRED

  SECURITY_ALERT

  SYSTEM_ANNOUNCEMENT
}

/**
 * Audience for admin-created announcements.
 */
enum NotificationAudience {
  EVERYONE
  BUYERS
  SELLERS
  ADMINS
  SELECTED_USERS
}

/**
 * Platforms for which admins prepare social content.
 */
enum AdminContentPlatform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
}

/**
 * Lifecycle of admin-created social content.
 */
enum AdminContentStatus {
  DRAFT
  READY
  ARCHIVED
}

/**
 * ============================================================
 * USERS
 * ============================================================
 */

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  name      String?
  createdAt DateTime @default(now())

  savedListings SavedListing[]

  /**
   * REFERRALS
   */
  referralCode String? @unique

  referralsMade Referral[] @relation("ReferralReferrer")

  referralReceived Referral? @relation("ReferralReferredUser")

  referralRewards ReferralReward[] @relation("ReferralRewardOwner")

  /**
   * SELLER BUSINESS
   */
  business Business?

  /**
   * DELETED PRODUCTS AND SERVICES
   */
  deletedProducts Product[] @relation("ProductDeletedBy")

  servicesDeleted Service[] @relation("ServiceDeletedBy")

  /**
   * SERVICE BOOKINGS
   */
  serviceBookings ServiceBooking[] @relation("ServiceBookingBuyer")

  serviceBookingsReceived ServiceBooking[] @relation("ServiceBookingSeller")

  serviceBookingsCancelled ServiceBooking[] @relation("ServiceBookingCancelledBy")

  serviceBookingMessages ServiceBookingMessage[] @relation("ServiceBookingMessageSender")

  /**
   * BUSINESS DELETION AND CLAIM REQUESTS
   */
  deletionRequestsRequested BusinessDeletionRequest[] @relation("BusinessDeletionRequestedBy")

  deletionRequestsReviewed BusinessDeletionRequest[] @relation("BusinessDeletionReviewedBy")

  claimRequestsRequested BusinessClaimRequest[] @relation("BusinessClaimRequestedBy")

  claimRequestsReviewed BusinessClaimRequest[] @relation("BusinessClaimReviewedBy")

  /**
   * REVIEWS
   */
  reviews BusinessReview[]

  /**
   * NOTIFICATIONS
   */
  notifications Notification[]

  notificationPreferences NotificationPreference[]

  notificationAnnouncements NotificationAnnouncement[] @relation("NotificationAnnouncementCreatedBy")

  /**
   * ANALYTICS
   */
  businessViewEvents BusinessViewEvent[]

  /**
   * ADMIN CONTENT
   */
  adminContents AdminContent[] @relation("AdminContentCreatedBy")

  /**
   * ==========================================================
   * CHECKOUT AND ORDERS
   * ==========================================================
   */

  // A buyer has one active cart.
  cart Cart?

  // Orders placed by this buyer.
  orders Order[] @relation("BuyerOrders")

  // Seller orders assigned to this seller account.
  sellerOrders SellerOrder[] @relation("SellerOrders")

  // Reviews written for individual products.
  productReviews ProductReview[]
}

/**
 * ============================================================
 * REFERRALS
 * ============================================================
 */

model Referral {
  id String @id @default(cuid())

  // User who referred the new account.
  referrerId String

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)

  // The referred account can have only one referrer.
  referredUserId String @unique

  referredUser User @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  referrerRole Role
  referredRole Role

  status ReferralStatus @default(PENDING)

  qualifiedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  rewards ReferralReward[]

  /**
   * REVIEWS
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([status, createdAt])
  @@index([referredRole, status])
}

model ReferralReward {
  id String @id @default(cuid())

  userId String

  user User @relation("ReferralRewardOwner", fields: [userId], references: [id], onDelete: Restrict)

  referralId String?

  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  type ReferralRewardType

  status ReferralRewardStatus @default(GRANTED)

  quantity Int @default(1)

  milestone Int?

  rewardKey String @unique

  grantedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([referralId, type])
  @@unique([userId, type, milestone])
  @@index([userId, status])
  @@index([type, status])
  @@index([referralId])
}

/**
 * ============================================================
 * LOCATIONS
 * ============================================================
 */

model Location {
  id String @id @default(cuid())

  area String

  street String?

  address String?

  lat  Float?
  long Float?

  verification LocationVerificationStatus @default(UNVERIFIED)

  businesses Business[]

  @@index([area])
  @@index([street])
  @@index([lat, long])
  @@index([verification])
}

/**
 * ============================================================
 * BUSINESS SOCIAL LINKS
 * ============================================================
 */

model BusinessSocialLink {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  handle   String

  @@index([businessId])
  @@index([businessId, platform])
}

/**
 * ============================================================
 * CATEGORIES
 * ============================================================
 */

model Category {
  id String @id @default(cuid())

  name String @unique

  iconKey String @default("Store")

  isActive Boolean @default(true)

  sortOrder Int @default(0)

  business BusinessCategory[]
  products Product[]
  services Service[]
  requests BuyerRequest[]

  @@index([isActive, sortOrder])
}

model BusinessCategory {
  businessId String
  categoryId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
  @@index([categoryId])
}

/**
 * ============================================================
 * BUSINESSES
 * ============================================================
 */

model Business {
  id String @id @default(cuid())

  name String

  ownerName String?

  ownerId String? @unique

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  description String?

  locationId String?

  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  priceMin Int?
  priceMax Int?

  availability Availability @default(ASK_SELLER)

  phone String?

  status BusinessStatus @default(ACTIVE)

  verification VerificationStatus @default(UNVERIFIED)

  notes    String?
  imageUrl String?

  onboardedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  deletedAt DateTime?

  showContactInfo Boolean @default(false)

  categories BusinessCategory[]

  products Product[]

  services Service[]

  socialLinks BusinessSocialLink[]

  matches Match[]

  contactEvents ContactEvent[]

  deletionRequests BusinessDeletionRequest[]

  claimRequests BusinessClaimRequest[]

  viewEvents BusinessViewEvent[]

  reviews BusinessReview[]

  /**
   * Orders fulfilled by this business.
   */
  sellerOrders SellerOrder[]

  @@index([status])
  @@index([verification])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([ownerId])
  @@index([locationId])
}

/**
 * ============================================================
 * BUSINESS REVIEWS
 * ============================================================
 */

model BusinessReview {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating Int

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@index([createdAt])
}

/**
 * ============================================================
 * PRODUCTS
 * ============================================================
 */
model Product {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id])

  // Product pricing
  price         Int?
  priceMin      Int?
  priceMax      Int?
  originalPrice Int?

  savedBy SavedListing[]

  availability Availability @default(ASK_SELLER)

  keywords String[] @default([])

  imageUrl String?

  images ProductImage[]

  status BusinessStatus @default(ACTIVE)

  deletedAt DateTime?

  deletedById String?

  deletedBy User? @relation("ProductDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INVENTORY
   * null = inventory tracking disabled.
   * 0    = out of stock.
   * > 0  = available quantity.
   */

  stockQuantity Int?

  /**
   * CART AND ORDERS
   */

  cartItems CartItem[]

  orderItems OrderItem[]

  /**
   * PRODUCT REVIEWS
   */

  productReviews ProductReview[]

  @@index([businessId])
  @@index([businessId, deletedAt])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([status, deletedAt, createdAt])
}

/**
 * ============================================================
 * PRODUCT IMAGES
 * ============================================================
 */

model ProductImage {
  id String @id @default(cuid())

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  publicId String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([productId, sortOrder])
}

/**
 * ============================================================
 * SERVICES
 * ============================================================
 */

model Service {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  price    Int?
  priceMin Int?
  priceMax Int?

  savedBy SavedListing[]

  durationMinutes Int?

  fulfillmentType ServiceFulfillmentType @default(FLEXIBLE)

  bookingType ServiceBookingType @default(REQUEST)

  availability Availability @default(ASK_SELLER)

  keywords String[] @default([])

  imageUrl String?

  images ServiceImage[]

  status BusinessStatus @default(ACTIVE)

  deletedAt DateTime?

  deletedById String?

  deletedBy User? @relation("ServiceDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  bookings ServiceBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, status, deletedAt])
  @@index([categoryId])
  @@index([status, deletedAt, createdAt])
  @@index([availability])
  @@index([fulfillmentType])
  @@index([bookingType])
}

/**
 * ============================================================
 * SERVICE IMAGES
 * ============================================================
 */

model ServiceImage {
  id String @id @default(cuid())

  serviceId String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  url      String
  publicId String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([serviceId])
  @@index([serviceId, sortOrder])
}

/**
 * ============================================================
 * SERVICE BOOKINGS
 * ============================================================
 */

model ServiceBooking {
  id String @id @default(cuid())

  bookingCode String? @unique

  serviceId String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  buyerId String

  buyer User @relation("ServiceBookingBuyer", fields: [buyerId], references: [id], onDelete: Restrict)

  sellerId String?

  seller User? @relation("ServiceBookingSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  bookingType ServiceBookingType @default(REQUEST)

  status ServiceBookingStatus @default(PENDING)

  requestedFor DateTime?

  scheduledFor DateTime?

  quantity Int @default(1)

  contactPhone String?

  fulfillmentType ServiceFulfillmentType?

  fulfillmentAddress String?

  buyerMessage String?

  quotedPrice  Int?
  quoteMessage String?
  quoteSentAt  DateTime?

  agreedPrice     Int?
  quoteAcceptedAt DateTime?

  currency String @default("NGN")

  merchantNote String?

  acceptedAt  DateTime?
  declinedAt  DateTime?
  cancelledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  declineReason String?

  cancellationReason String?
  cancelledById      String?

  cancelledBy User? @relation("ServiceBookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  messages ServiceBookingMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, status, createdAt])
  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, createdAt])
  @@index([requestedFor])
  @@index([scheduledFor])
}

/**
 * ============================================================
 * SERVICE BOOKING MESSAGES
 * ============================================================
 */

model ServiceBookingMessage {
  id String @id @default(cuid())

  bookingId String

  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  senderId String

  sender User @relation("ServiceBookingMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  body String

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([senderId, createdAt])
  @@index([bookingId, readAt])
}

/**
 * ============================================================
 * BUYER REQUESTS AND MATCHES
 * ============================================================
 */

model BuyerRequest {
  id String @id @default(cuid())

  query       String
  requestCode String @unique

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  budget       Int?
  locationArea String?
  quantity     Int?
  description  String?
  imageUrl     String?

  status RequestStatus @default(NEW)

  buyerContact String?

  createdAt DateTime @default(now())

  matches Match[]

  @@index([status])
  @@index([buyerContact])
  @@index([categoryId])
}

model Match {
  id String @id @default(cuid())

  requestId String

  request BuyerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  score         Int     @default(0)
  addedManually Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([requestId, businessId])
  @@index([businessId])
}

/**
 * ============================================================
 * ANALYTICS EVENTS
 * ============================================================
 */

model ContactEvent {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id])

  requestId String?

  platform SocialPlatform

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, platform])
  @@index([createdAt])
}

model SearchEvent {
  id String @id @default(cuid())

  query       String
  category    String?
  resultCount Int     @default(0)
  location    String?
  minPrice    Int?
  maxPrice    Int?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

model BusinessViewEvent {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id])

  visitorId String

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, visitorId])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, businessId, createdAt])
}

model AdminNote {
  id String @id @default(cuid())

  businessId String?
  requestId  String?

  content   String
  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([requestId])
}

/**
 * ============================================================
 * BUSINESS DELETION REQUESTS
 * ============================================================
 */

model BusinessDeletionRequest {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  requestedById String

  requestedBy User @relation("BusinessDeletionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  reason String?

  status DeletionRequestStatus @default(PENDING)

  reviewedById String?

  reviewedBy User? @relation("BusinessDeletionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}

/**
 * ============================================================
 * BUSINESS CLAIM REQUESTS
 * ============================================================
 */

model BusinessClaimRequest {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  requestedById String

  requestedBy User @relation("BusinessClaimRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  reason String?

  status ClaimRequestStatus @default(PENDING)

  reviewedById String?

  reviewedBy User? @relation("BusinessClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, requestedById, status])
  @@index([businessId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
}

/**
 * ============================================================
 * REMARKET NOTIFICATION SYSTEM
 * ============================================================
 */

model Notification {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  title    String
  message  String
  priority NotificationPriority @default(NORMAL)

  data Json?

  readAt DateTime?

  dedupeKey String? @unique

  announcementId String?

  announcement NotificationAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, type])
  @@index([type])
  @@index([announcementId])
}

model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel

  status NotificationDeliveryStatus @default(PENDING)

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  providerMessageId String?

  error String?

  createdAt DateTime @default(now())

  @@unique([notificationId, channel])
  @@index([notificationId])
  @@index([channel, status])
  @@index([status])
}

model NotificationPreference {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationType NotificationType

  inApp    Boolean @default(true)
  push     Boolean @default(false)
  email    Boolean @default(false)
  whatsapp Boolean @default(false)
  sms      Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@unique([userId, notificationType])
  @@index([userId])
  @@index([notificationType])
}

model NotificationAnnouncement {
  id String @id @default(cuid())

  title   String
  message String

  audience NotificationAudience

  priority NotificationPriority @default(NORMAL)

  createdById String

  createdBy User @relation("NotificationAnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  data Json?

  notifications Notification[]

  createdAt DateTime @default(now())

  @@index([audience])
  @@index([createdById])
  @@index([createdAt])
}

/**
 * ============================================================
 * ADMIN SOCIAL CONTENT
 * ============================================================
 */

model AdminContent {
  id String @id @default(cuid())

  title String

  caption String

  imageUrl      String?
  imagePublicId String?

  linkUrl String?

  platforms AdminContentPlatform[] @default([])

  status AdminContentStatus @default(DRAFT)

  createdById String

  createdBy User @relation("AdminContentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([createdById, createdAt])
}

/**
 * ============================================================
 * SAVED LISTINGS
 * ============================================================
 */

model SavedListing {
  id String @id @default(cuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String?

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  serviceId String?

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([userId, serviceId])
  @@index([userId, createdAt])
  @@index([productId])
  @@index([serviceId])
}

/**
 * ============================================================
 * SHOPPING CART
 * ============================================================
 * Each buyer has one active cart.
 * A cart can contain products from multiple businesses.
 */

model Cart {
  id String @id @default(cuid())

  buyerId String @unique

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id String @id @default(cuid())

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A product can only appear once in a particular cart.
  @@unique([cartId, productId])
  @@index([productId])
}

/**
 * ============================================================
 * BUYER ORDERS
 * ============================================================
 * One buyer checkout creates one parent order.
 * If the buyer purchases from multiple businesses,
 * separate SellerOrder records are created underneath it.
 */

model Order {
  id String @id @default(cuid())

  // Human-readable order reference generated by the application.
  orderCode String @unique

  buyerId String

  buyer User @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(PLACED)

  // All monetary values are stored in whole currency units.
  // For ReMarket MVP, currency is NGN.
  itemsSubtotal Int

  deliveryFee Int @default(0)

  totalAmount Int

  currency String @default("NGN")

  /**
   * DELIVERY INFORMATION SNAPSHOT
   * These values are copied into the order at checkout.
   * Later changes to the buyer's profile or address
   * must not change an existing order's delivery details.
   */

  deliveryRecipient String

  deliveryPhone String

  deliveryAddress String

  deliveryArea String

  deliveryLandmark String?

  deliveryNotes String?

  sellerOrders SellerOrder[]

  payments Payment[]

  completedAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

/**
 * ============================================================
 * SELLER ORDERS
 * ============================================================
 * Each seller receives a separate order record.
 * Example:
 * A buyer purchases from three businesses.
 * ReMarket creates:
 * - One Order.
 * - Three SellerOrder records.
 * Each seller manages their own fulfilment.
 */

model SellerOrder {
  id String @id @default(cuid())

  sellerOrderCode String @unique

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  sellerId String

  seller User @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  status SellerOrderStatus @default(PENDING_ACCEPTANCE)

  // Subtotal for this seller's products only.
  subtotal Int

  sellerNote String?

  items OrderItem[]

  acceptedAt DateTime?

  rejectedAt DateTime?

  dispatchedAt DateTime?

  deliveredAt DateTime?

  completedAt DateTime?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One seller order per business within a parent order.
  @@unique([orderId, businessId])
  @@index([orderId])
  @@index([sellerId, status, createdAt])
  @@index([businessId, status, createdAt])
}

/**
 * ============================================================
 * ORDER ITEMS
 * ============================================================
 * Product name, price and image are snapshots.
 * They remain available in order history even if the
 * original product is subsequently edited or removed.
 */

model OrderItem {
  id String @id @default(cuid())

  sellerOrderId String

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  // Nullable so historical orders survive product removal.
  productId String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String

  productImageUrl String?

  unitPrice Int

  quantity Int

  lineTotal Int

  createdAt DateTime @default(now())

  @@index([sellerOrderId])
  @@index([productId])
}

/**
 * ============================================================
 * PAYMENTS
 * ============================================================
 * This model stores payment records and provider references.
 * It does not activate any payment provider.
 * Payment processing will be connected separately after
 * ReMarket settles its payment-provider arrangement.
 */

model Payment {
  id String @id @default(cuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount Int

  currency String @default("NGN")

  status PaymentStatus @default(PENDING)

  method PaymentMethod?

  // Example: provider name when one is configured.
  provider String?

  // External transaction reference.
  providerReference String? @unique

  // Prevents duplicate payment attempts for the same operation.
  idempotencyKey String? @unique

  failureReason String?

  metadata Json?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model ProductReview {
  id        String @id @default(cuid())
  productId String
  userId    String

  rating  Int
  comment String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
}
